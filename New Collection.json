				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const carBrandID = Math.floor(Math.random() * (5 - 1 + 1) + 1);\r",
							"pm.collectionVariables.set('carBrandID', carBrandID)\r",
							"\r",
							"let carModelID =(carBrandID-1)*5+ Math.floor(Math.random() * (5 - 1 + 1) + 1);\r",
							"if(carBrandID==4){\r",
							"    carModelID =Math.floor(Math.random() * (18 - 16 + 1) + 16);\r",
							"}else if(carBrandID==5){\r",
							"    carModelID =Math.floor(Math.random() * (23 - 19 + 1) + 19);\r",
							"}\r",
							"pm.collectionVariables.set('carModelID', carModelID)\r",
