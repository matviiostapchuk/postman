					"script": {
						"exec": [
							"const NewMileAge = pm.collectionVariables.get(\"mileAge\")+Math.floor(Math.random() * (1000 - 1 + 1) + 1)+ pm.collectionVariables.get(\"NewMileAge\")\r",
							"pm.collectionVariables.set('NewMileAge', NewMileAge)\r",
							"\r",
							"const Liters =Math.floor(Math.random() * (15 - 1 + 1) + 1)+pm.collectionVariables.get(\"Liters\");\r",
