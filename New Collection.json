		{
			"name": "Papochka",
			"item": [
				{
					"name": "Sign Up with different test cases",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test(`Validation test for name: \"${pm.collectionVariables.get(\"expectedResult\")}\"`, () => {\r",
									"    const response = pm.response.json();\r",
									"    const expectedResult = pm.collectionVariables.get(\"expectedResult\");\r",
									"    \r",
									"    if (expectedResult === \"success\") {\r",
									"        pm.expect(response.status).to.equal(\"ok\");\r",
									"    } else {\r",
									"        pm.expect(response.error).to.equal(expectedResult);\r",
									"    }\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const cases = [\r",
									"    { name: \"\", lastName: \"\", expected: \"Field is required\" },\r",
									"    { name: \"A\", lastName: \"B\", expected: \"Name must be at least 2 characters\" },\r",
									"    { name: \"Test\" , lastName: \"A\".repeat(51) , expected: \"lastname too long\" },\r",
									"    { name: \"John\", lastName: \"Doe\", email: \"Royce23@hotmail.com\", password: \"Qwerty12345\",repeatPassword: \"Qwerty12345\", expected: \"an existing email\" },\r",
									"    { name: \"John\", lastName: \"Doe\", email: pm.variables.replaceIn('{{$randomEmail}}'), password: \"Qwerty12345\",repeatPassword: \"Qwerty12345666\", expected: \"different passwords\" },\r",
									"    { name: \"John\", lastName: \"Doe\", email: pm.variables.replaceIn('{{$randomEmail}}'), password: \"Qwerty12345\",repeatPassword: \"Qwerty12345\", expected: \"success\" }\r",
									"];\r",
									"\r",
									"// Зберігаємо поточний індекс тест кейса\r",
									"let index = pm.collectionVariables.get(\"TestIndex\") || 0;\r",
									"\r",
									"// Встановлюємо дані для поточного тест кейса\r",
									"pm.collectionVariables.set(\"Name\", cases[index].name);\r",
									"pm.collectionVariables.set(\"LastName\", cases[index].lastName);\r",
									"pm.collectionVariables.set(\"email\", cases[index].email);\r",
									"pm.collectionVariables.set(\"NewPassword\", cases[index].password);\r",
									"pm.collectionVariables.set(\"NewPassword1\", cases[index].repeatPassword);\r",
									"pm.collectionVariables.set(\"expectedResult\", cases[index].expected);\r",
									"\r",
									"// Перевіряємо чи це останній тест\r",
									"if (index < cases.length - 1) {\r",
									"    // Якщо ні - готуємо наступний\r",
									"    pm.collectionVariables.set(\"TestIndex\", index + 1);\r",
									"    pm.execution.setNextRequest(pm.info.requestName);\r",
									"} else {\r",
									"    // Якщо всі тести пройдені - скидаємо лічильник\r",
									"    pm.collectionVariables.set(\"TestIndex\", 0);\r",
									"    pm.execution.setNextRequest(\"Profile with different test cases\");\r",
									"}\r",
									"\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"name\": \"{{Name}}\",\r\n    \"lastName\": \"{{LastName}}\",\r\n    \"email\": \"{{email}}\",\r\n    \"password\": \"{{NewPassword}}\",\r\n    \"repeatPassword\": \"{{NewPassword1}}\"\r\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/auth/signup",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"auth",
								"signup"
							]
						}
					},
					"response": []
				},
				{
					"name": "Profile with different test cases",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"const cases = [\r",
									"    { photo: \"\", dateBirth: \"\",country: pm.variables.replaceIn('{{$randomCountry}}'), expected: \"Field is required\" },\r",
									"    { photo: `user-${Date.now()}.jpg`, dateBirth: \"2024\",country: pm.variables.replaceIn('{{$randomCountry}}'), expected: \"dateBirth is error\" }, \r",
									"    { photo: `user-${Date.now()}.jpg`, dateBirth: new Date().toISOString(), country: \"fo2rth\", expected: \"unvalid country\" },\r",
									"    { photo: `user-${Date.now()}.jpg` , dateBirth: new Date().toISOString() , country:\"A\".repeat(51), expected: \"country too long\" },\r",
									"    { photo: `user-${Date.now()}.jpg`, dateBirth: new Date().toISOString(), country: pm.variables.replaceIn('{{$randomCountry}}'), expected: \"success\" },\r",
									"];\r",
									"\r",
									"// Зберігаємо поточний індекс тест кейса\r",
									"let index = pm.collectionVariables.get(\"TestIndex\") || 0;\r",
									"\r",
									"// Встановлюємо дані для поточного тест кейса\r",
									"pm.collectionVariables.set(\"FileName\", cases[index].photo);\r",
									"pm.collectionVariables.set(\"dateBirth\", cases[index].dateBirth);\r",
									"pm.collectionVariables.set(\"Country\", cases[index].country);\r",
									"pm.collectionVariables.set(\"expectedResult\", cases[index].expected);\r",
									"\r",
									"// Перевіряємо чи це останній тест\r",
									"if (index < cases.length - 1) {\r",
									"    // Якщо ні - готуємо наступний\r",
									"    pm.collectionVariables.set(\"TestIndex\", index + 1);\r",
									"    pm.execution.setNextRequest(pm.info.requestName);\r",
									"} else {\r",
									"    // Якщо всі тести пройдені - скидаємо лічильник\r",
									"    pm.collectionVariables.set(\"TestIndex\", 0);\r",
									"    pm.execution.setNextRequest(\"Sign Up\");\r",
									"}\r",
									""
								],
								"type": "text/javascript",
								"packages": {}
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"let jsonData = JSON.parse(pm.request.body.raw);\r",
									"\r",
									"pm.test(`Validation test for name: \"${pm.collectionVariables.get(\"expectedResult\")}\"`, () => {\r",
									"    const response = pm.response.json();\r",
									"    const expectedResult = pm.collectionVariables.get(\"expectedResult\");\r",
									"    \r",
									"    if (expectedResult === \"success\") {\r",
									"        pm.expect(response.status).to.equal(\"ok\");\r",
									"        pm.expect(pm.response.json().data.country).to.be.a('string')\r",
									"        pm.expect(pm.response.json().data.dateBirth).to.match(/[1-2]\\d{3}-[0-1]\\d-[0-3]\\dT[0-2]\\d:[0-5]\\d:[0-5]\\d\\.[000Z]/);\r",
									"        pm.expect(jsonData.photo).to.be.a('string').and.to.match(/[user]-\\d+\\.[jpg]/);\r",
									"    } else {\r",
									"        pm.expect(response.error).to.equal(expectedResult);\r",
									"    }\r",
									"});"
								],
								"type": "text/javascript",
								"packages": {}
							}
						}
					],
					"request": {
						"method": "PUT",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\r\n    \"photo\": \"{{FileName}}\",\r\n    \"name\": \"{{Name}}\",\r\n    \"lastName\": \"{{LastName}}\",\r\n    \"dateBirth\": \"{{dateBirth}}\",\r\n    \"country\": \"{{Country}}\"\r\n  }",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{baseUrl}}/users/profile",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"users",
								"profile"
							]
						}
					},
					"response": []
				}
			]
